{UTF-8}
Warming Rate Base = 0.04
	~	degC/Year
	~	Long-term surface warming. Data file: 1990-2017 mean was 1.2 degC above the 3 earlier decades, about 0.04 degC per year. Stands in for the Sun box of the sketch.
	|

Warming Scenario Factor = 1
	~	Dmnl
	~	Scenario multiplier on warming. 0 = no further warming, 2 = twice as fast.
	|

Warming Rate = Warming Rate Base * Warming Scenario Factor
	~	degC/Year
	~	Warming of the surface water.
	|

Initial Water Temperature = 10.8
	~	degC
	~	Assumed 1980 annual mean at 0.5 m. Only the change matters.
	|

Water Temperature = INTEG(Warming Rate, Initial Water Temperature)
	~	degC
	~	Annual mean water temperature at 0.5 m depth.
	|

Reference Temperature = Initial Water Temperature
	~	degC
	~	Temperature at which all temperature effects equal 1.
	|

Temperature Anomaly = Water Temperature - Reference Temperature
	~	degC
	~	Warming relative to 1980.
	|

Depth Damping = 0.6
	~	Dmnl
	~	Deep water warms more slowly than the 0.5 m series. Assumption.
	|

Spawning Depth Anomaly = Temperature Anomaly * Depth Damping
	~	degC
	~	Estimated warming at spawning depth.
	|

Circulation Table([(0,0)-(6,1)],
	(0,1),(0.5,0.85),(1,0.65),(1.5,0.45),(2,0.32),(3,0.27),(6,0.25))
	~	Dmnl
	~	Share of full winter mixing versus warming.
	|

Circulation Index = Circulation Table(Temperature Anomaly)
	~	Dmnl
	~	1 = full overturn, about 0.3 = poor circulation.
	|

Lake Volume = 47.6
	~	km3
	~	Volume of the Obersee. 1 km3 times 1 ug/L = 1 t of P.
	|

Agriculture P Load = 60
	~	t/Year
	~	Diffuse agricultural and natural P input. Assumed split of the 100-110 t/yr total.
	|

Agriculture Factor = 1
	~	Dmnl
	~	Scenario lever. 0.5 = halve agricultural P input.
	|

Wastewater Table([(1980,0)-(2060,1400)],
	(1980,1206),(1985,859),(1990,440),(1995,211),(2000,118),(2005,52),(2010,46),(2015,52),(2020,51),(2025,49),(2030,48),(2060,48))
	~	t/Year
	~	Point source and legacy P input reconstructed to follow the approximate observed P decline. Replace with your own data.
	|

Wastewater P Load = Wastewater Table(Time)
	~	t/Year
	~	P entering via wastewater.
	|

P Loss Rate = 0.35
	~	1/Year
	~	Outflow via the Rhine plus sedimentation.
	|

Release Table([(0,0)-(14,1)],
	(0,1),(0.5,0.6),(1,0.2),(1.5,0),(14,0))
	~	Dmnl
	~	Sediment P is released only when bottom O2 is close to zero.
	|

Sediment Release Capacity = 30
	~	t/Year
	~	Maximum internal P load when the deep water is anoxic. Assumption.
	|

Sediment P Release = Sediment Release Capacity * Release Table(Deep Water O2)
	~	t/Year
	~	Internal P loading from the sediment.
	|

P Loading = Agriculture P Load * Agriculture Factor + Wastewater P Load
	~	t/Year
	~	External P input.
	|

P Loss = P Loss Rate * Phosphorus
	~	t/Year
	~	Outflow and sedimentation of P.
	|

Starting Phosphorus = 80 * Lake Volume
	~	t
	~	Total P in 1980, about 80 ug/L.
	|

Phosphorus = INTEG(P Loading + Sediment P Release - P Loss, Starting Phosphorus)
	~	t
	~	Total phosphorus in the Obersee.
	|

P Concentration = Phosphorus / Lake Volume
	~	ug/L
	~	Volume weighted annual mean total P.
	|

Algae Capacity = 14
	~	ugChl/L
	~	Saturating phytoplankton biomass as chlorophyll a.
	|

P Half Saturation = 22
	~	ug/L
	~	P concentration at half of Algae Capacity. Assumption.
	|

Algae = Algae Capacity * P Concentration / (P Concentration + P Half Saturation)
	~	ugChl/L
	~	Phytoplankton biomass. P is the limiting nutrient.
	|

O2 Saturation = 11
	~	mg/L
	~	Deep water O2 after full overturn. Assumption.
	|

Renewal Time = 4
	~	Year
	~	Time scale of O2 renewal at full circulation.
	|

O2 Use Coefficient = 0.19
	~	mg/L/Year
	~	O2 consumed per unit of algae. Calibrated to about 6 mg/L at 5 to 7 ug/L P with poor circulation.
	|

O2 Half Saturation = 0.5
	~	mg/L
	~	O2 consumption fades as O2 approaches zero.
	|

O2 Renewal = Circulation Index * (O2 Saturation - Deep Water O2) / Renewal Time
	~	mg/L/Year
	~	Oxygen supply by winter mixing.
	|

O2 Consumption = O2 Use Coefficient * Algae * Deep Water O2 / (Deep Water O2 + O2 Half Saturation)
	~	mg/L/Year
	~	Oxygen use by breakdown of dead algae.
	|

Starting Deep Water O2 = 3
	~	mg/L
	~	Assumed 1980 value.
	|

Deep Water O2 = INTEG(O2 Renewal - O2 Consumption, Starting Deep Water O2)
	~	mg/L
	~	Minimum O2 near the lake bottom.
	|

Zoop Growth Rate = 6
	~	1/Year
	~	Maximum growth rate of zooplankton biomass.
	|

Zoop Algae Half Saturation = 2
	~	ugChl/L
	~	Algae level at half maximal zooplankton growth.
	|

Zoop Mortality Rate = 2
	~	1/Year
	~	Background loss of zooplankton.
	|

Crowding Coefficient = 0.00029
	~	1/t/Year
	~	Density dependent loss that keeps zooplankton bounded.
	|

Adult Consumption = 0.6
	~	kg/Year
	~	Zooplankton eaten per adult whitefish at full feeding. Assumption.
	|

Juvenile Consumption = 0.4
	~	kg/Year
	~	Zooplankton eaten per juvenile whitefish at full feeding. Assumption.
	|

Zoop Half Saturation = 2000
	~	t
	~	Zooplankton biomass at which fish feed at half rate.
	|

Feeding Ratio = Zooplankton / (Zooplankton + Zoop Half Saturation)
	~	Dmnl
	~	Fraction of maximum feeding achieved by fish.
	|

Zoop Production = Zoop Growth Rate * Zooplankton * Algae / (Algae + Zoop Algae Half Saturation)
	~	t/Year
	~	Algae to zooplankton.
	|

Zoop Natural Loss = Zoop Mortality Rate * Zooplankton
	~	t/Year
	~	Background loss.
	|

Zoop Crowding Loss = Crowding Coefficient * Zooplankton * Zooplankton
	~	t/Year
	~	Density dependent loss.
	|

Fish Grazing = (Adult Whitefish * Adult Consumption + Juvenile Whitefish * Juvenile Consumption) * 1000 * Feeding Ratio
	~	t/Year
	~	Whitefish eat zooplankton. Million fish times kg is 1000 t.
	|

Stickleback Grazing Rate = 0.5
	~	1/Year
	~	Zooplankton removed by stickleback per unit of stickleback index.
	|

Stickleback Grazing = Stickleback Grazing Rate * Stickleback Index * Zooplankton
	~	t/Year
	~	Competition for food by the stickleback.
	|

Zooplankton = INTEG(Zoop Production - Zoop Natural Loss - Zoop Crowding Loss - Fish Grazing - Stickleback Grazing, 3000)
	~	t
	~	Zooplankton biomass, model scaled.
	|

Stickleback Switch = 1
	~	Dmnl
	~	1 = include the stickleback invasion, 0 = without it.
	|

Stickleback Table([(1980,0)-(2100,1)],
	(1980,0),(2011,0),(2012,0.1),(2015,1),(2100,1))
	~	Dmnl
	~	Pelagic stickleback invasion from 2012.
	|

Stickleback Index = Stickleback Switch * Stickleback Table(Time)
	~	Dmnl
	~	Relative stickleback pressure.
	|

Stickleback Egg Predation = 0.5
	~	Dmnl
	~	Share of egg survival lost at full stickleback pressure. Assumption.
	|

Stickleback Larval Effect = 0.3
	~	Dmnl
	~	Share of larval survival lost at full stickleback pressure. Assumption.
	|

Female Fraction = 0.5
	~	Dmnl
	~	Share of adults that are females.
	|

Mean Weight = 0.3
	~	kg
	~	Mean weight of an adult whitefish. Assumption.
	|

Eggs per kg = 19000
	~	1/kg
	~	16000 to 22000 eggs per kg of female.
	|

Eggs per Adult = Female Fraction * Mean Weight * Eggs per kg
	~	eggs/fish
	~	Potential fecundity.
	|

Reference Feeding Ratio = 0.5
	~	Dmnl
	~	Feeding ratio at which fecundity and larval survival are normal.
	|

Food Index = MIN(1.5, Feeding Ratio / Reference Feeding Ratio)
	~	Dmnl
	~	Food condition of the fish.
	|

Eggs Laid = Adult Whitefish * Eggs per Adult * Food Index
	~	million eggs/Year
	~	Adults to eggs, boosted by zooplankton.
	|

O2 Egg Table([(0,0)-(14,1)],
	(0,0),(2,0.1),(4,0.5),(6,0.95),(8,1),(14,1))
	~	Dmnl
	~	Eggs overwinter on the lake bed and need more than 6 mg/L.
	|

Temperature Table([(0,0)-(6,1)],
	(0,1),(1,0.85),(2,0.6),(3,0.35),(4,0.15),(6,0.02))
	~	Dmnl
	~	Warmer water raises egg and larval mortality. Shape is an assumption.
	|

Temperature Effect = Temperature Table(Spawning Depth Anomaly)
	~	Dmnl
	~	Multiplier on early life survival.
	|

O2 Effect on Eggs = O2 Egg Table(Deep Water O2)
	~	Dmnl
	~	Multiplier on egg survival.
	|

Base Egg Survival = 0.3
	~	Dmnl
	~	Egg to hatch survival at good conditions. Assumption.
	|

Egg Survival = Base Egg Survival * O2 Effect on Eggs * Temperature Effect * (1 - Stickleback Egg Predation * Stickleback Index)
	~	Dmnl
	~	Survival of eggs to hatching.
	|

Hatching = Eggs Laid * Egg Survival
	~	million larvae/Year
	~	Natural hatch.
	|

Stocking Baseline = 120
	~	million larvae/Year
	~	Hatchery stocking until the cutback. Assumption.
	|

Stocking Reduced = 20
	~	million larvae/Year
	~	Stocking after the cutback. Assumption.
	|

Stocking Cutback Year = 2018
	~	Year
	~	Year from which stocking is reduced.
	|

Stocked Larvae = IF THEN ELSE(Time < Stocking Cutback Year, Stocking Baseline, Stocking Reduced)
	~	million larvae/Year
	~	Added fish roe of the sketch.
	|

Larval Survival Base = 0.0022
	~	Dmnl
	~	Larva to juvenile survival before density dependence. Calibrated.
	|

Potential Recruits = (Hatching + Stocked Larvae) * Larval Survival Base * Temperature Effect * (1 - Stickleback Larval Effect * Stickleback Index) * Food Index
	~	million fish/Year
	~	Recruits without crowding.
	|

Recruit Ceiling = 10
	~	million fish/Year
	~	Recruitment capacity at normal food. Calibrated.
	|

Recruitment Capacity = Recruit Ceiling * Feeding Ratio / Reference Feeding Ratio
	~	million fish/Year
	~	Capacity scales with zooplankton availability.
	|

Recruitment = Potential Recruits / (1 + Potential Recruits / Recruitment Capacity)
	~	million fish/Year
	~	Birth fish flow of the sketch.
	|

Maturation Time = 2
	~	Year
	~	Time as juvenile before entering the adult stock.
	|

Juvenile Mortality = 0.4
	~	1/Year
	~	Juvenile mortality. Assumption.
	|

Maturation = Juvenile Whitefish / Maturation Time
	~	million fish/Year
	~	Juveniles becoming adults.
	|

Juvenile Deaths = Juvenile Whitefish * Juvenile Mortality
	~	million fish/Year
	~	Juvenile mortality flow.
	|

Juvenile Whitefish = INTEG(Recruitment - Maturation - Juvenile Deaths, 4)
	~	million fish
	~	Age 0 to 2 whitefish.
	|

Adult Mortality = 0.25
	~	1/Year
	~	Natural death rate of adults.
	|

Natural Deaths = Adult Whitefish * Adult Mortality
	~	million fish/Year
	~	Death fish natural of the sketch.
	|

Fishing Fraction Normal = 0.3
	~	1/Year
	~	Share of adults caught per year before the ban. Assumption.
	|

Fishing Fraction Reopened = 0.15
	~	1/Year
	~	Share caught after reopening in 2027. Scenario lever.
	|

Ban Start = 2024
	~	Year
	~	Whitefish fishing ban starts.
	|

Ban End = 2027
	~	Year
	~	Ban ends May 2027, modelled as start of 2027.
	|

Fishing Fraction = IF THEN ELSE(Time < Ban Start, Fishing Fraction Normal, IF THEN ELSE(Time < Ban End, 0, Fishing Fraction Reopened))
	~	1/Year
	~	Fishing mortality of adults.
	|

Fish Caught = Adult Whitefish * Fishing Fraction
	~	million fish/Year
	~	Adults caught per year.
	|

Adult Whitefish = INTEG(Maturation - Natural Deaths - Fish Caught, 5)
	~	million fish
	~	Fish adults of the sketch.
	|

Catch Tonnes = Fish Caught * Mean Weight * 1000
	~	t/Year
	~	Compare with the catch series in your data file.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2060
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 1980
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 0.25
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Year [0,?]
	~	The time step for the simulation.
	|

