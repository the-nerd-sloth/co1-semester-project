External P load reconstructed = MAX(0,P concentration conversion*(Observed phosphorus slope+P loss rate*Observed phosphorus))
~ tP/Year
~ Exploratory relationship; not a validated ecological forecast.
|

P inflow = External P load reconstructed*IF THEN ELSE(Time>=Policy start year,Phosphorus load multiplier,1)
~ tP/Year
~ Exploratory relationship; not a validated ecological forecast.
|

P release from sediment = Maximum internal P release*MAX(0,1-Deep water O2/Anoxia threshold)
~ tP/Year
~ Exploratory relationship; not a validated ecological forecast.
|

P sedimentation and outflow = P loss rate*Phosphorus
~ tP/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Phosphorus = INTEG(P inflow+P release from sediment-P sedimentation and outflow,Initial phosphorus)
~ tP
~ Exploratory relationship; not a validated ecological forecast.
|

P concentration = Phosphorus/P concentration conversion
~ ugP/L
~ Exploratory relationship; not a validated ecological forecast.
|

Algae growth = Algae max production*P concentration/(P half saturation+P concentration)
~ mgA/L/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Algae dieback = Algae/Algae turnover time
~ mgA/L/Year
~ Non-grazing effective loss; excludes the new explicit Algae grazing flow. Its inherited O2 coupling is an approximation.
|

Algae = INTEG(Algae growth-Algae dieback-Algae grazing,Initial algae)
~ mgA/L
~ Exploratory relationship; not a validated ecological forecast.
|

Zooplankton growth = Zooplankton production*Algae/(Algae food half saturation+Algae)
~ crustaceans/m2/Year
~ Effective numerical production response to algae. Explicit algae grazing supplies a separate loss pathway; abundance and algae biomass do not form a carbon-conserving budget.
|

Zooplankton mortality = Zoo natural mortality*Zooplankton
~ crustaceans/m2/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Grazing by whitefish = Whitefish clearance*Adult whitefish*Zooplankton
~ crustaceans/m2/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Grazing by sticklebacks = Stickleback zoo mortality*Stickleback pressure*Zooplankton
~ crustaceans/m2/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Zooplankton = INTEG(Zooplankton growth-Zooplankton mortality-Grazing by whitefish-Grazing by sticklebacks,Initial zooplankton)
~ crustaceans/m2
~ Exploratory relationship; not a validated ecological forecast.
|

Water temperature = Observed bottom temperature+Warming rate*MAX(0,Time-Warming start year)
~ degC
~ Exploratory relationship; not a validated ecological forecast.
|

O2 resupply by winter mixing = O2 mixing rate*MAX(0,O2 saturation proxy-Deep water O2)*EXP(-Temperature response*(Water temperature-Reference temperature))
~ mgO2/L/Year
~ Exploratory relationship; not a validated ecological forecast.
|

O2 depletion = MIN(Deep water O2/TIME STEP,O2 demand coefficient*Algae dieback)
~ mgO2/L/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Deep water O2 = INTEG(O2 resupply by winter mixing-O2 depletion,Initial oxygen)
~ mgO2/L
~ Exploratory relationship; not a validated ecological forecast.
|

Stickleback pressure = MAX(0,MIN(1,(Time-Stickleback invasion year)/Stickleback ramp duration))*IF THEN ELSE(Time>=Policy start year,1-MAX(0,MIN(1,Stickleback reduction)),1)
~ Dmnl
~ Exploratory relationship; not a validated ecological forecast.
|

Food factor = MIN(1.5,MAX(0.05,(Zooplankton/(Food half saturation+Zooplankton))/Food normalization))
~ Dmnl
~ Exploratory relationship; not a validated ecological forecast.
|

Oxygen factor = Deep water O2/(Oxygen half saturation+Deep water O2)/Oxygen normalization
~ Dmnl
~ Exploratory relationship; not a validated ecological forecast.
|

Base egg survival = 0.000112897812192913
~ Dmnl
~ REFITTED simple baseline survival probability. Independent constant, not divided by Eggs per adult. Food, oxygen, density and temperature still modify survival. Natural fecundity remains a simple assumed constant.
|

Egg survival fraction = MIN(1,MAX(0,Base egg survival*Food factor*Oxygen factor*EXP(-Egg temperature sensitivity*MAX(0,Water temperature-Reference temperature))/(1+Adult biomass/Recruitment density scale)))
~ Dmnl
~ Exploratory relationship; not a validated ecological forecast.
|

Spawning = Eggs per adult*Adult whitefish
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Stocking = IF THEN ELSE(Time>=Policy start year,MAX(0,Stocking program),0)
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Egg stage exit = Eggs and larvae/Egg duration
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Early recruitment = Egg survival fraction*Egg stage exit
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Egg and larval mortality = (1-Egg survival fraction)*Egg stage exit+Stickleback egg predation*Stickleback pressure*Eggs and larvae
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Eggs and larvae = INTEG(Spawning+Stocking-Early recruitment-Egg and larval mortality,Initial eggs)
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Juvenile progression = Juvenile year 1/Juvenile stage duration
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Maturation = Juvenile year 2/Juvenile stage duration
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Juvenile 1 mortality = Juvenile mortality rate*Juvenile year 1
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Juvenile 2 mortality = Juvenile mortality rate*Juvenile year 2
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Juvenile year 1 = INTEG(Early recruitment-Juvenile progression-Juvenile 1 mortality,Initial juvenile 1)
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Juvenile year 2 = INTEG(Juvenile progression-Maturation-Juvenile 2 mortality,Initial juvenile 2)
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Natural death = (Adult natural mortality rate+Starvation mortality rate*MAX(0,1-Food factor))*Adult whitefish
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Fishing mortality = Fishing mortality scale*IF THEN ELSE(Time<Ban start year,Historical effort,IF THEN ELSE(Time<Ban end year,Historical effort*(1-MAX(0,MIN(1,Ban strength))),MAX(0,Post ban effort)))
~ 1/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Adult biomass = Adult whitefish*Mean adult weight/Weight conversion
~ tFish
~ Exploratory relationship; not a validated ecological forecast.
|

Catch = MIN(Fishing mortality*Adult whitefish,MIN(Adult whitefish/TIME STEP,MAX(0,Catch quota)*Weight conversion/Mean adult weight))
~ fish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Catch biomass = Catch*Mean adult weight/Weight conversion
~ tFish/Year
~ Exploratory relationship; not a validated ecological forecast.
|

Adult whitefish = INTEG(Maturation-Natural death-Catch,Initial adults)
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Initial adults = Initial adult biomass*Weight conversion/Initial adult weight
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Initial eggs = Eggs per adult*Initial adults*Egg duration
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Initial juvenile 1 = Base egg survival*Initial eggs/Egg duration/(1/Juvenile stage duration+Juvenile mortality rate)
~ fish
~ Inherited equilibrium-style initialization; omits initial density/food/oxygen adjustments. Retained assumption, potential early transient.
|

Initial juvenile 2 = Initial juvenile 1/Juvenile stage duration/(1/Juvenile stage duration+Juvenile mortality rate)
~ fish
~ Inherited equilibrium-style initialization, not an observed juvenile cohort.
|

Model survey index = Survey catchability*Adult biomass
~ surveyUnit
~ Exploratory relationship; not a validated ecological forecast.
|

Total fish excluding eggs = Juvenile year 1+Juvenile year 2+Adult whitefish
~ fish
~ Exploratory relationship; not a validated ecological forecast.
|

Algae grazing rate = 0.2
~ 1/Year
~ ASSUMED effective grazing coefficient 0.2 per Year at Reference zooplankton. Grazing pathway is evidence-supported, numeric coefficient is NOT field-estimated; test sensitivity.
|

Algae grazing = Algae grazing rate*Zooplankton/Reference zooplankton*Algae
~ mgA/L/Year
~ NEW explicit phytoplankton loss due to zooplankton. Effective annual-scale relationship; not a carbon mass balance and does not resolve individual grazer diets.
|

Grazing time at reference = 1/Algae grazing rate
~ Year
~ DIAGNOSTIC reciprocal of assumed grazing coefficient; not independently measured.
|

Total algae loss rate = 1/Algae turnover time+Algae grazing rate*Zooplankton/Reference zooplankton
~ 1/Year
~ DIAGNOSTIC sum of assumed non-grazing and grazing loss coefficients.
|

Effective algae turnover time = 1/Total algae loss rate
~ Year
~ DIAGNOSTIC: reciprocal of total modeled instantaneous first-order loss rate; not measured lifespan.
|

Eggs produced per year = Spawning
~ fish/Year
~ DIAGNOSTIC alias for annualized Spawning flow; natural egg count, not recruits.
|

INITIAL TIME = 1997
~ Year
~ Simulation control.
|

FINAL TIME = 2050
~ Year
~ Simulation control.
|

TIME STEP = 0.0078125
~ Year
~ Reduced Euler time step to 1/128 Year. Numerical convergence and independent PySD execution tested; Vensim GUI not available.
|

SAVEPER = 1
~ Year
~ Simulation control.
|

