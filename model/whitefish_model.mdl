	~	Dmnl
	~	DATA for comparison: whitefish survey index (IGKB/IBKF) 1997-2022.
	|

Zooplankton = INTEG(Zooplankton growth-Zooplankton mortality-Grazing by whitefish-Grazing by sticklebacks\
		,Initial zooplankton)
	~	kInd/m2
	~	STOCK: crustacean zooplankton (whitefish food), in 1000 individuals per m2.
	|

Zooplankton growth = Max zooplankton production*Phosphorus concentration/(Phosphorus concentration\
		+Zooplankton P half saturation)
	~	kInd/m2/Year
	~	More phosphorus -> more algae -> more zooplankton (algae are not modelled \
		separately).
	|

Zooplankton mortality = Zooplankton*Zooplankton mortality rate
	~	kInd/m2/Year
	~	Natural death of zooplankton.
	|

Grazing by whitefish = Zooplankton*Whitefish grazing rate*Adult whitefish
	~	kInd/m2/Year
	~	Zooplankton eaten by whitefish: more whitefish -> less food left (B1 \
		predator-prey).
	|

Grazing by sticklebacks = Zooplankton*Stickleback grazing rate*Stickleback pressure
	~	kInd/m2/Year
	~	Zooplankton eaten by sticklebacks: competition with whitefish for food.
	|

Young whitefish = INTEG(Recruitment-Maturation-Young mortality,Initial young)
	~	t
	~	STOCK: young whitefish (eggs, larvae, juveniles) that are not yet \
		catchable, in tonnes of future adult biomass.
	|

Adult whitefish = INTEG(Maturation-Natural death-Catch,Initial adults)
	~	t
	~	STOCK: adult (catchable, spawning) whitefish biomass in Lake Constance \
		(Obersee).
	|

Recruitment = Adult whitefish*Max recruitment rate*Food effect*Oxygen effect*Stickleback egg effect
	~	t/Year
	~	New young whitefish per year: more adults -> more offspring (R1). Depends \
		on food (zooplankton), deep-water oxygen and sticklebacks eating eggs and \
		larvae.
	|

Maturation = Young whitefish/Maturation time
	~	t/Year
	~	Young fish become adults after about 2.5 years.
	|

Young mortality = Young whitefish*Young mortality rate
	~	t/Year
	~	Young fish that die before they mature.
	|

Natural death = Adult whitefish*Adult mortality rate
	~	t/Year
	~	Natural death of adults.
	|

Catch = IF THEN ELSE(Time<Ban start year,Fishing rate*Adult whitefish,IF THEN ELSE(Time\
		<Ban end year,(1-Fishing ban)*Fishing rate*Adult whitefish,MIN(Catch from 2027,Fishing rate\
		*Adult whitefish)))
	~	t/Year
	~	Catch (B2). Before 2024: a fixed share of the adult stock. 2024 - April \
		2027: fishing ban. From May 2027: a fixed annual catch (scenario), at most \
		Fishing rate x stock.
	|

Food effect = (Zooplankton/(Zooplankton+Food half saturation))/(Reference zooplankton\
		/(Reference zooplankton+Food half saturation))
	~	Dmnl
	~	More zooplankton -> better fed whitefish -> more offspring survive. 1 at \
		the reference zooplankton level.
	|

Oxygen effect = (Deep water oxygen/(Deep water oxygen+Oxygen half saturation))/(Reference oxygen\
		/(Reference oxygen+Oxygen half saturation))
	~	Dmnl
	~	Whitefish eggs lie on the lake bottom over winter and die if oxygen is low \
		(IGKB, 2014). 1 at the reference oxygen level.
	|

Stickleback egg effect = 1-Stickleback egg impact*Stickleback pressure
	~	Dmnl
	~	Share of whitefish eggs and larvae that are not eaten by sticklebacks.
	|

Stickleback pressure = IF THEN ELSE(Time<Stickleback start year,0,IF THEN ELSE(Time<Stickleback decline year\
		,1,IF THEN ELSE(Time<Scenario start year,1-Stickleback decline,Stickleback pressure from 2027\
		)))
	~	Dmnl
	~	Stickleback index: 0 before 2012, 1 from 2012 (spread into open water), \
		reduced by 80 % from 2024, scenario value from 2027.
	|

Model survey index = Adult whitefish*Survey catchability
	~	Dmnl
	~	Model value comparable to the observed survey index.
	|

Max zooplankton production=3444.7
	~	kInd/m2/Year
	~	CALIBRATED against observed zooplankton 1961-2025.
	|

Zooplankton P half saturation = 21.309
	~	ugP/L
	~	CALIBRATED: phosphorus level at which zooplankton production is half its \
		maximum.
	|

Zooplankton mortality rate = 2
	~	1/Year
	~	ASSUMPTION: zooplankton turns over quickly (several generations per year).
	|

Whitefish grazing rate = 0.000626102
	~	1/(t*Year)
	~	CALIBRATED: share of zooplankton eaten per t of adult whitefish and year.
	|

Stickleback grazing rate=0.203165
	~	1/Year
	~	CALIBRATED: share of zooplankton eaten by sticklebacks per year at full \
		stickleback pressure.
	|

Food half saturation=213.009
	~	kInd/m2
	~	CALIBRATED: zooplankton level at which the food effect is halved.
	|

Reference zooplankton = 300
	~	kInd/m2
	~	Reference level, about today's zooplankton density (IGKB).
	|

Max recruitment rate=1.05091
	~	1/Year
	~	CALIBRATED: offspring (t) per t of adults and year at reference food and \
		oxygen.
	|

Oxygen half saturation = 2
	~	mgO2/L
	~	ASSUMPTION: oxygen level at which egg survival is halved.
	|

Reference oxygen = 6
	~	mgO2/L
	~	Oxygen above 6 mg/L is considered a good supply of the deep water (IGKB, \
		2018).
	|

Stickleback egg impact=0.505776
	~	Dmnl
	~	CALIBRATED: share of whitefish eggs/larvae eaten at full stickleback \
		pressure.
	|

Stickleback start year = 2012
	~	Year
	~	Sticklebacks spread into the open water in 2012 (Wasser-Agenda 21, 2023; \
		SRF, 2024).
	|

Stickleback decline year = 2024
	~	Year
	~	The stickleback population declined in 2024 (IGKB, n.d.-a).
	|

Stickleback decline = 0.8
	~	Dmnl
	~	Decline of about 80 % (IGKB, n.d.-a). SCENARIO 0 = no decline.
	|

Scenario start year = 2027
	~	Year
	~	From this year on the scenario values apply.
	|

Stickleback pressure from 2027 = 0.2
	~	Dmnl
	~	SCENARIO: 0.2 = stays low, 1 = renewed stickleback pressure.
	|

Maturation time=2.5
	~	Year
	~	ASSUMPTION: whitefish mature at about 2-3 years.
	|

Young mortality rate=0.3
	~	1/Year
	~	ASSUMPTION.
	|

Adult mortality rate=0.25
	~	1/Year
	~	ASSUMPTION: natural mortality of adults.
	|

Fishing rate = 0.5
	~	1/Year
	~	ASSUMPTION: share of the adult stock caught per year before the ban (about \
		40 % per year).
	|

Ban start year = 2024
	~	Year
	~	Fishing ban from January 2024 (IBKF; Frei & Kugler, 2026).
	|

Ban end year = 2027.33
	~	Year
	~	Fishing reopens in May 2027 (SRF, 2026).
	|

Fishing ban = 1
	~	Dmnl
	~	SCENARIO switch: 1 = ban 2024-2027 as decided, 0 = no ban (fishing \
		continues).
	|

Catch from 2027 = 25
	~	t/Year
	~	SCENARIO: annual catch from May 2027. Target of the IBKF: 20-30 t (SRF, \
		2026).
	|

Initial adults = 906.673
	~	t
	~	CALIBRATED: adult stock in 1950.
	|

Initial young = 1511.98
	~	t
	~	Young stock in 1950, in equilibrium with the 1950 conditions.
	|

Initial zooplankton = 331.731
	~	kInd/m2
	~	Zooplankton in 1950, in equilibrium with the 1950 conditions.
	|

Survey catchability = 0.0156565
	~	Dmnl/t
	~	CALIBRATED: scales the model stock to the survey index.
	|

INITIAL TIME  = 1950
	~	Year
	~	Simulation start.
	|

FINAL TIME  = 2050
	~	Year
	~	Simulation end.
	|

TIME STEP  = 0.0625
	~	Year
	~	Euler integration step.
	|

SAVEPER  = 1
	~	Year
	~	Output interval.
	|

